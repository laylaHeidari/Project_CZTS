&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME CZTS_ES_U6_FORCE_S1
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QS

  &DFT
    UKS .FALSE.
    CHARGE 0
    MULTIPLICITY 1
    PLUS_U_METHOD MULLIKEN

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    &MGRID
      NGRIDS 12
      CUTOFF 300
      REL_CUTOFF 50
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-14
    &END QS

    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON

    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 100
      SCF_GUESS ATOMIC
      ADDED_MOS 100

      &DIAGONALIZATION ON
      &END DIAGONALIZATION

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBROYDEN 8
      &END MIXING

      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF

    &EXCITED_STATES T
      STATE -1
      XC_KERNEL_METHOD NUMERIC
      DEBUG_FORCES T
    &END EXCITED_STATES

    &XC
      &XC_FUNCTIONAL
        &PBE
        &END PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF [angstrom] 16
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC

    &PRINT
      &MULLIKEN OFF
      &END MULLIKEN

      &HIRSHFELD OFF
      &END HIRSHFELD
    &END PRINT

  &END DFT

  &PROPERTIES
    &TDDFPT
      KERNEL FULL
      NSTATES 5
      MAX_ITER 200
      CONVERGENCE [eV] 1.0E-5
      RKS_TRIPLETS F

      &MGRID
        NGRIDS 12
        CUTOFF 300
      &END MGRID

      &LINRES
        EPS 1.0E-10
      &END LINRES

    &END TDDFPT
  &END PROPERTIES

  &SUBSYS
    &CELL
      A 10.8683996201  0.0000000000  0.0000000000
      B 0.0000000000  10.8683996201  0.0000000000
      C 0.0000000000  0.0000000000  10.8495998383
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME czts_reference_structure.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11

      &DFT_PLUS_U ON
        L 2
        U_MINUS_J [eV] 6.0
      &END DFT_PLUS_U
    &END KIND

    &KIND Zn
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
    &END KIND

    &KIND Sn
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

  &PRINT
    &FORCES ON
      FILENAME =CZTS_ES_U6_FORCE_S1.forces
      NDIGITS 10
    &END FORCES
  &END PRINT

&END FORCE_EVAL